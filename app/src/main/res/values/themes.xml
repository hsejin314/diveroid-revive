<resources>
    <style name="Theme.DiveroidRevive" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/bg</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSurface">@color/panel</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/accent_dim</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:fontFamily">@font/rajdhani_medium</item>
        <item name="fontFamily">@font/rajdhani_medium</item>
        <item name="colorControlNormal">@color/border</item>
        <item name="colorControlActivated">@color/accent</item>
        <item name="materialAlertDialogTheme">@style/DiveDialog</item>
        <item name="alertDialogTheme">@style/DiveDialog</item>
    </style>

    <style name="Theme.DiveroidRevive.Fullscreen" parent="Theme.DiveroidRevive">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="DiveDialog" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorSurface">@color/panel</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:fontFamily">@font/rajdhani_medium</item>
        <item name="fontFamily">@font/rajdhani_medium</item>
    </style>
</resources>
